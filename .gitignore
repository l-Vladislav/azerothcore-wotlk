#
# AI tools
#
# Track .claude/ project docs (nemesis, familiars, dbc, agent-memory, etc.);
# ignore only machine-local config + runtime lock.
.claude/settings.local.json

#
# IDE & other software
#
/.settings/
/.externalToolBuilders/*
/.vs
/out
# exclude in all levels
nbproject/
.sync.ffs_db
*.kate-swp
.browse.VC*
.idea
cmake-build-*/*
coverage-report/
.vs

.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
