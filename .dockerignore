/cmake-build-debug/*
/build*/
/var/*
!/var/build/.gitkeep
!/var/ccache/.gitkeep
/env/dist/*
!/env/dist/.gitkeep
/env/user/*
/.env*
.idea
!.gitkeep

# do not ignore the ccache folder (used by the ci)
!/var/docker/ccache

# Large dirs never needed by the Docker build. The Dockerfile only COPYs
# CMakeLists.txt/conf/deps/src/modules/apps/data and bind-mounts the top-level
# .git; everything below is pure build-context bloat (was multi-GB, stalling
# the context transfer before compilation even started).
/backups/
/launcher/
/.claude/
modules/**/.git/
# The `**` form above did not actually exclude anything (2.8GB context observed
# on 2026-08-21, ~780MB of it module .git dirs). Module clones are exactly one
# level deep, so match them literally as well.
modules/*/.git
modules/*/.git/**
